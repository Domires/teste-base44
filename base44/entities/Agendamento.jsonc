{
  "name": "Agendamento",
  "description": "Janela de inspeção e de preenchimento do plano de ação por tipo de inspeção e ano, definidas livremente pelo Admin (origem: dbo.Agendamento)",
  "type": "object",
  "properties": {
    "TipoDeInspecaoId": {
      "type": "string"
    },
    "Ano": {
      "type": "number",
      "description": "Ano da data inicial da inspeção (AnoDataInicial)"
    },
    "InspecaoDtInicial": {
      "type": "string",
      "format": "date"
    },
    "InspecaoDtFinal": {
      "type": "string",
      "format": "date"
    },
    "PaDtInicial": {
      "type": "string",
      "format": "date",
      "description": "Início do prazo de preenchimento do PA"
    },
    "PaDtFinal": {
      "type": "string",
      "format": "date",
      "description": "Fim do prazo de preenchimento do PA"
    }
  },
  "required": [
    "TipoDeInspecaoId",
    "Ano",
    "InspecaoDtInicial",
    "InspecaoDtFinal"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}