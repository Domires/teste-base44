{
  "name": "ResponsavelSgi",
  "description": "Responsável SGI pela área (origem: dbo.ResponsavelSgi)",
  "type": "object",
  "properties": {
    "Nome": {
      "type": "string"
    },
    "Email": {
      "type": "string",
      "description": "E-mail corporativo do(a) responsável SGI (login)"
    },
    "Cargo": {
      "type": "string"
    }
  },
  "required": [
    "Nome",
    "Email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}