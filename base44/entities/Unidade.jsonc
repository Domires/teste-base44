{
  "name": "Unidade",
  "description": "Unidade (planta) da ICL (origem: dbo.Unidade)",
  "type": "object",
  "properties": {
    "Nome": {
      "type": "string"
    },
    "Sigla": {
      "type": "string",
      "description": "Sigla usada nas planilhas SOL/GRD"
    },
    "Escopo": {
      "type": "string"
    },
    "GestorIndustrial": {
      "type": "string",
      "description": "E-mail do gestor industrial"
    }
  },
  "required": [
    "Nome",
    "Sigla"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}