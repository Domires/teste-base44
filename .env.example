# Copie para .env (ou defina no ambiente) — todas são opcionais em desenvolvimento.

# Porta da API (o Vite repassa /api e /uploads para ela)
API_PORT=3001

# Administrador criado no primeiro start
ADMIN_EMAIL=admin@sol.local

# Usuário "logado" por padrão no ambiente local (não há tela de login; no Base44 o usuário vem da plataforma)
DEV_USER_EMAIL=admin@sol.local

# Pasta dos dados locais (banco, uploads, e-mails não enviados)
DATA_DIR=

# SMTP — sem SMTP_HOST os e-mails são gravados em server/data/outbox/
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# O "modo teste" dos e-mails é configurado pelo Admin (Programação › Modo teste de e-mails), não aqui.
